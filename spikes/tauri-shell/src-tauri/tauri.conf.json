{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DORMBIT Spike",
  "version": "0.0.0",
  "identifier": "io.github.amirmlotfy.dormbit.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [{ "label": "main", "title": "DORMBIT spike", "width": 900, "height": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "13.0" }
  }
}
